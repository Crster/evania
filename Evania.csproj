<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Evania</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
        <Platform Condition="'$(Platform)'=='AnyCPU' or '$(Platform)'==''">x64</Platform>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\Evania.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Rendered by Tools\Make-Assets.ps1. The manifest resolves the PNGs by scale qualifier at
      runtime, and WindowIconService loads Evania.ico from the output folder, so they must sit next
      to the AppxManifest.xml that run-app.ps1 registers: Content alone only reaches the package
      layout during Visual Studio's packaging pass, which leaves a dotnet build (and therefore the
      dev deploy) showing whatever was laid out last.
    -->
    <Content Include="Assets\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Evania.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Tools\EvaniaMascot.cs is the asset generator's raster helper, compiled on demand by
    Make-Assets.ps1 with Add-Type. The SDK's default glob would otherwise pull it into the app
    assembly as dead code.
  -->
  <ItemGroup>
    <Compile Remove="Tools\**\*.cs" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.WinUI.Managed" Version="2.0.9" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
    <PackageReference Include="ScreenRecorderLib" Version="7.0.0" />
    <!--
      WinUI 3 has no tray icon, and the shell one has to live as long as the hidden window it
      stands for, so it comes from H.NotifyIcon rather than hand-rolled Shell_NotifyIcon.
      ProtectedData is not part of the Windows shared framework (the 10.0.11 ref pack ships
      Microsoft.Win32.Primitives/Registry only), so DPAPI needs its own package. H.NotifyIcon's
      generated-icon support requires System.Drawing.Common 10.x, so the pin above follows the
      runtime instead of downgrading the tray library (NU1605).
    -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
  </PropertyGroup>
</Project>