<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
		<RootNamespace>Evania</RootNamespace>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Platforms>x64</Platforms>
		<Platform Condition="'$(Platform)'=='AnyCPU' or '$(Platform)'==''">x64</Platform>
		<RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
		<PublishProfile>win-$(Platform).pubxml</PublishProfile>
		<UseWinUI>true</UseWinUI>
		<WinUISDKReferences>false</WinUISDKReferences>
		<EnableMsixTooling>true</EnableMsixTooling>
		<Nullable>enable</Nullable>
		<ApplicationIcon>Assets\Evania.ico</ApplicationIcon>
	</PropertyGroup>
	<ItemGroup>
		<Content Include="Assets\**\*.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Assets\Evania.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Public\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="LICENSE;PRIVACY.md;TERMS.md;THIRD-PARTY-NOTICES.md">
			<Link>Assets\Legal\%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Manifest Include="$(ApplicationManifest)" />
	</ItemGroup>
	<ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
		<ProjectCapability Include="Msix" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
		<PackageReference Include="Microsoft.Xaml.Behaviors.WinUI.Managed" Version="2.0.9" />
		<PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
		<PackageReference Include="LiteDB" Version="5.0.21" />
		<PackageReference Include="System.Drawing.Common" Version="10.0.11" />
		<PackageReference Include="ScreenRecorderLib" Version="7.0.0" />
		<PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
		<PackageReference Include="ZXing.Net" Version="0.16.9" />
	</ItemGroup>
	<PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
		<HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
	</PropertyGroup>

	<!-- Publish Properties -->
	<PropertyGroup>
		<!-- Not conditioned on $(Configuration): restore evaluates as Debug, and a false
		     value there means the Crossgen2 pack never gets restored, so a Release
		     publish fails with "a valid runtime package was not found". -->
		<PublishReadyToRun>True</PublishReadyToRun>
		<PublishTrimmed>False</PublishTrimmed>
		<PackageCertificateKeyFile>Evania_TemporaryKey.pfx</PackageCertificateKeyFile>
		<AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
		<GenerateAppInstallerFile>False</GenerateAppInstallerFile>
		<AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
		<AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
		<GenerateTestArtifacts>False</GenerateTestArtifacts>
		<UapAppxPackageBuildMode>StoreUpload</UapAppxPackageBuildMode>
		<AppxBundle>Never</AppxBundle>
		<HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
	</PropertyGroup>

	<Target Name="NormalizePackagedInstallerNames" AfterTargets="_AddWindowsInstallScriptToTestLayout" Condition="Exists('$(MSBuildProjectDirectory)\AppPackages')">
		<Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$appPackages = Join-Path '$(MSBuildProjectDirectory)' 'AppPackages'; Get-ChildItem -LiteralPath $appPackages -Directory | Where-Object { $_.Name -like '*_Test' } | ForEach-Object { $newName = $_.Name.Substring(0, $_.Name.Length - 5); $newPath = Join-Path $_.Parent.FullName $newName; if (Test-Path -LiteralPath $newPath) { Remove-Item -LiteralPath $newPath -Recurse -Force }; Move-Item -LiteralPath $_.FullName -Destination $newPath }; Get-ChildItem -LiteralPath $appPackages -Directory | Where-Object { $_.Name -like '*_Test' } | Remove-Item -Recurse -Force; @($appPackages, (Join-Path '$(MSBuildProjectDirectory)' 'BundleArtifacts')) | Where-Object { Test-Path -LiteralPath $_ } | ForEach-Object { Get-ChildItem -LiteralPath $_ -File | Where-Object { $_.Name -like '*.appinstaller*' -or $_.Name -eq 'index.html' } | ForEach-Object { $content = Get-Content -LiteralPath $_.FullName -Raw; $updated = $content -replace '_Test/', '/'; if ($updated -ne $content) { Set-Content -LiteralPath $_.FullName -Value $updated -Encoding UTF8 } } }&quot;" />
	</Target>
</Project>
