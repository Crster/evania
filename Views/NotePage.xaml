<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Evania.Views.NotePage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Evania.Models"
    xmlns:converters="using:Evania.Converters"
    xmlns:editor="using:Evania.Controls.MarkdownEditor"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="NotePage_Loaded"
    Unloaded="NotePage_Unloaded">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="AllowFocusOnInteraction" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
    </Page.Resources>

    <Grid Padding="32,20,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <InfoBar
            Grid.Row="0"
            Severity="Error"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Closed="ErrorBar_Closed"
            Margin="0,0,0,16" />

        <Grid
            Grid.Row="1"
            RowSpacing="4"
            Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: back + title + save state (flat, no container) -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Button
                    Style="{StaticResource ToolbarButtonStyle}"
                    Click="Back_Click"
                    ToolTipService.ToolTip="Back to notes">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock
                        Text="NOTE"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.65" />
                    <TextBox
                        PlaceholderText="Untitled note"
                        Text="{x:Bind ViewModel.Title, Mode=TwoWay}"
                        FontSize="24"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Background="Transparent"
                        Padding="0" />
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsSaving, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressRing Width="16" Height="16" IsActive="True" />
                    <TextBlock Text="Saving" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Divider between title and toolbar -->
            <Rectangle
                Grid.Row="1"
                Height="1"
                Margin="0,10,0,0"
                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- Formatting toolbar row: buttons left, attachments toggle right -->
            <Grid Grid.Row="2" Margin="0,4,0,4">
                <ScrollViewer
                    HorizontalScrollMode="Auto"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollMode="Disabled"
                    Margin="-8,0,0,0">
                    <StackPanel
                        x:Name="Toolbar"
                        Orientation="Horizontal"
                        Spacing="2"
                        HorizontalAlignment="Left">
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Bold" Click="Bold_Click"><FontIcon Glyph="&#xE8DD;" FontSize="14" /></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Italic" Click="Italic_Click"><FontIcon Glyph="&#xE8DB;" FontSize="14" /></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Strikethrough" Click="Strikethrough_Click"><FontIcon Glyph="&#xEDE0;" FontSize="14" /></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Highlight" Click="Highlight_Click"><FontIcon Glyph="&#xE7E6;" FontSize="14" /></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Inline code" Click="Code_Click"><FontIcon Glyph="&#xE84B;" FontSize="14" /></Button>
                    <Rectangle Width="1" Height="16" Margin="6,0" Opacity="0.25" Fill="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Heading 1" Click="Heading1_Click"><TextBlock Text="H1" FontSize="12" FontWeight="SemiBold" /></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Heading 2" Click="Heading2_Click"><TextBlock Text="H2" FontSize="12" FontWeight="SemiBold" /></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Heading 3" Click="Heading3_Click"><TextBlock Text="H3" FontSize="12" FontWeight="SemiBold" /></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Quote" Click="Blockquote_Click"><FontIcon Glyph="&#xE90A;" FontSize="14" /></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Bulleted list" Click="List_Click"><FontIcon Glyph="&#xE8FD;" FontSize="14" /></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Numbered list" Click="OrderedList_Click"><FontIcon Glyph="&#xE700;" FontSize="14" /></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Task list" Click="TaskList_Click"><FontIcon Glyph="&#xE73A;" FontSize="14" /></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Table" Click="Table_Click"><FontIcon Glyph="&#xE80A;" FontSize="14" /></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Horizontal rule" Click="HorizontalRule_Click"><FontIcon Glyph="&#xE738;" FontSize="14" /></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Code block" Click="CodeBlock_Click"><FontIcon Glyph="&#xE943;" FontSize="14" /></Button>
                    <Rectangle Width="1" Height="16" Margin="6,0" Opacity="0.25" Fill="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Insert image" Click="Image_Click"><FontIcon Glyph="&#xE8B9;" FontSize="14" /></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Attach file" Click="File_Click"><FontIcon Glyph="&#xE723;" FontSize="14" /></Button>
                    </StackPanel>
                </ScrollViewer>
                <ToggleButton
                    x:Name="AttachmentsToggle"
                    HorizontalAlignment="Right"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTipService.ToolTip="Attachments"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE723;" FontSize="14" />
                        <TextBlock Text="Attachments" FontSize="12" />
                    </StackPanel>
                </ToggleButton>
            </Grid>

            <!-- Editor + attachments sidebar -->
            <Grid Grid.Row="3" ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <editor:MarkdownEditor
                    x:Name="Editor"
                    PlaceholderText="Start writing..."
                    Padding="16,12,16,12"
                    Margin="0,4,0,0"
                    MarkdownChanged="Editor_MarkdownChanged"
                    LinkInvoked="Editor_LinkInvoked" />

                <!-- Attachments sidebar -->
                <Border
                    Grid.Column="1"
                    Width="280"
                    Padding="16,12,0,0"
                    Visibility="{x:Bind AttachmentsToggle.IsChecked, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Rectangle
                            Width="1"
                            HorizontalAlignment="Left"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <StackPanel Margin="16,0,0,0" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE723;" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                                <TextBlock Text="Attachments" FontSize="12" FontWeight="SemiBold" Opacity="0.7" VerticalAlignment="Center" />
                            </StackPanel>
                            <ListView
                                ItemsSource="{x:Bind ViewModel.Attachments}"
                                SelectionMode="None"
                                Background="Transparent">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Padding="0,2">
                                            <FontIcon Glyph="&#xE723;" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SizeText}" FontSize="11" Opacity="0.6" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="2"
                                                Tag="{Binding}"
                                                Click="OpenAttachment_Click"
                                                Background="Transparent"
                                                ToolTipService.ToolTip="Open attachment">
                                                <SymbolIcon Symbol="OpenFile" />
                                            </Button>
                                            <Button
                                                Grid.Column="3"
                                                Tag="{Binding}"
                                                Click="RemoveAttachment_Click"
                                                Background="Transparent"
                                                ToolTipService.ToolTip="Remove attachment">
                                                <SymbolIcon Symbol="Delete" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                Text="No attachments yet."
                                FontSize="12"
                                Opacity="0.5" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid
            x:Name="ListPanel"
            Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top-center action, matching other pages -->
            <Button
                Style="{StaticResource AccentButtonStyle}"
                Click="New_Click"
                Padding="20,10"
                HorizontalAlignment="Center"
                Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="16" />
                    <TextBlock Text="New note" FontSize="14" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="0,0,0,12">
                <TextBox
                    PlaceholderText="Filter notes"
                    Text="{x:Bind ViewModel.Filter, Mode=TwoWay}"
                    Height="36"
                    VerticalContentAlignment="Center" />
                <ComboBox
                    Grid.Column="1"
                    ItemsSource="{x:Bind ViewModel.SortOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}"
                    MinWidth="180" />
            </Grid>

            <TextBlock
                Grid.Row="2"
                Text="No notes yet. Select New note to create one."
                Margin="0,24,0,12"
                HorizontalAlignment="Center"
                Opacity="0.65"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

            <ListView
                Grid.Row="2"
                x:Name="NoteList"
                ItemsSource="{x:Bind ViewModel.Notes}"
                SelectionMode="Single"
                DoubleTapped="NoteList_DoubleTapped">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding UpdatedText}" FontSize="11" Opacity="0.6" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Text="{Binding Preview}"
                                MaxLines="2"
                                TextWrapping="WrapWholeWords"
                                TextTrimming="CharacterEllipsis"
                                Opacity="0.7" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
