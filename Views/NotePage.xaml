<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Evania.Views.NotePage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Evania.Models"
    xmlns:converters="using:Evania.Converters"
    xmlns:editor="using:Evania.Controls.MarkdownEditor"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="NotePage_Loaded"
    Unloaded="NotePage_Unloaded">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="AllowFocusOnInteraction" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
        <!-- Pill buttons carry no chrome of their own: the pill's border is the surface, and the
             default Button template animates its fill on hover/press over any local Background,
             which would paint a second rounded rectangle inside the pill. -->
        <Style x:Key="AttachmentPillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The remove button is the one pill control that wants feedback, so it carries its own
             template: the shared pill style has no visual states, and the trash glyph is tinted with
             the theme's critical brush on hover/press to read as a destructive action. -->
        <Style
            x:Key="AttachmentPillDeleteButtonStyle"
            BasedOn="{StaticResource AttachmentPillButtonStyle}"
            TargetType="Button">
            <Setter Property="Padding" Value="2" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            x:Name="Content"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="Content"
                                                Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame
                                                    KeyTime="0"
                                                    Value="{ThemeResource SystemFillColorCriticalBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="Content"
                                                Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame
                                                    KeyTime="0"
                                                    Value="{ThemeResource SystemFillColorCriticalBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation
                                                Storyboard.TargetName="Content"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0.7"
                                                Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </ContentPresenter>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card-style list item: the default item template paints a flat bar, so the whole
             chrome is replaced with a rounded card. -->
        <Style x:Key="NoteCardItemStyle" TargetType="ListViewItem">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="CardBorder.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="CardBorder.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="CardBorder.BorderBrush" Value="{ThemeResource AccentControlElevationBorderBrush}" />
                                            <Setter Target="CardBorder.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border
                                x:Name="CardBorder"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Padding="14,12" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Padding="32,20,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <InfoBar
            Grid.Row="0"
            Severity="Error"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Closed="ErrorBar_Closed"
            Margin="0,0,0,16" />

        <Grid
            Grid.Row="2"
            RowSpacing="4"
            Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: back + title + save state (flat, no container) -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Button
                    Style="{StaticResource ToolbarButtonStyle}"
                    Click="Back_Click"
                    ToolTipService.ToolTip="Back to notes">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock
                        Text="NOTE"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.65" />
                    <TextBox
                        PlaceholderText="Untitled note"
                        Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        FontSize="24"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Background="Transparent"
                        Padding="0">
                        <TextBox.Resources>
                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsSaving, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ProgressRing Width="16" Height="16" IsActive="True" />
                        <TextBlock Text="Saving" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="Delete_Click"
                        ToolTipService.ToolTip="Delete note">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Divider between title and toolbar -->
            <Rectangle
                Grid.Row="1"
                Height="1"
                Margin="0,10,0,0"
                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- Formatting toolbar row -->
            <Grid Grid.Row="2" Margin="0,4,0,4">
                <ScrollViewer
                    HorizontalScrollMode="Auto"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollMode="Disabled"
                    Margin="-8,0,0,0">
                    <StackPanel
                        x:Name="Toolbar"
                        Orientation="Horizontal"
                        Spacing="2"
                        HorizontalAlignment="Left">
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Heading 1" Click="Heading1_Click"><TextBlock Text="H1" FontSize="12" FontWeight="SemiBold" /></Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Heading 2" Click="Heading2_Click"><TextBlock Text="H2" FontSize="12" FontWeight="SemiBold" /></Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Heading 3" Click="Heading3_Click"><TextBlock Text="H3" FontSize="12" FontWeight="SemiBold" /></Button>
                        <Rectangle Width="1" Height="16" Margin="6,0" Opacity="0.25" Fill="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Bold" Click="Bold_Click"><FontIcon Glyph="&#xE8DD;" FontSize="14" /></Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Italic" Click="Italic_Click"><FontIcon Glyph="&#xE8DB;" FontSize="14" /></Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Strikethrough" Click="Strikethrough_Click"><FontIcon Glyph="&#xEDE0;" FontSize="14" /></Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Highlight" Click="Highlight_Click"><FontIcon Glyph="&#xE7E6;" FontSize="14" /></Button>
                        <Rectangle Width="1" Height="16" Margin="6,0" Opacity="0.25" Fill="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Bulleted list" Click="List_Click"><FontIcon Glyph="&#xE8FD;" FontSize="14" /></Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Numbered list" Click="OrderedList_Click"><FontIcon Glyph="&#xE700;" FontSize="14" /></Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Task list" Click="TaskList_Click"><FontIcon Glyph="&#xE73A;" FontSize="14" /></Button>
                        <Rectangle Width="1" Height="16" Margin="6,0" Opacity="0.25" Fill="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Inline code" Click="Code_Click"><FontIcon Glyph="&#xE84B;" FontSize="14" /></Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Code block" Click="CodeBlock_Click"><FontIcon Glyph="&#xE943;" FontSize="14" /></Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Quote" Click="Blockquote_Click"><FontIcon Glyph="&#xE90A;" FontSize="14" /></Button>
                        <Rectangle Width="1" Height="16" Margin="6,0" Opacity="0.25" Fill="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Table" Click="Table_Click"><FontIcon Glyph="&#xE80A;" FontSize="14" /></Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Horizontal rule" Click="HorizontalRule_Click"><FontIcon Glyph="&#xE738;" FontSize="14" /></Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Date and time" Click="DateTime_Click"><FontIcon Glyph="&#xEC92;" FontSize="14" /></Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="UUIDv7" Click="Uuid_Click"><FontIcon Glyph="&#xE8EC;" FontSize="14" /></Button>
                        <Rectangle Width="1" Height="16" Margin="6,0" Opacity="0.25" Fill="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Insert image" Click="Image_Click"><FontIcon Glyph="&#xE8B9;" FontSize="14" /></Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="Attach file" Click="File_Click"><FontIcon Glyph="&#xE723;" FontSize="14" /></Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

                        <!-- Attachment pills -->
                        <ItemsControl
                            Grid.Row="3"
                            ItemsSource="{x:Bind ViewModel.Attachments}"
                            Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="12"
                                        Padding="8,4,4,4"
                                        Margin="0,0,6,4"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                        <Border.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Open" Click="AttachmentOpen_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Copy link" Click="AttachmentCopyLink_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Rename" Click="AttachmentRename_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8AC;" FontSize="14" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Border.ContextFlyout>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Button
                                                Style="{StaticResource AttachmentPillButtonStyle}"
                                                Tag="{Binding}"
                                                Click="AttachmentPill_Click">
                                                <TextBlock
                                                    Text="{Binding FileName}"
                                                    FontSize="12"
                                                    TextTrimming="CharacterEllipsis"
                                                    MaxWidth="200"
                                                    VerticalAlignment="Center" />
                                            </Button>
                                            <Button
                                                Style="{StaticResource AttachmentPillDeleteButtonStyle}"
                                                Tag="{Binding}"
                                                Click="AttachmentPillDelete_Click"
                                                ToolTipService.ToolTip="Remove attachment">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Editor -->
                        <editor:MarkdownEditor
                            Grid.Row="4"
                            x:Name="Editor"
                            PlaceholderText="Start writing..."
                            Padding="0,12,0,12"
                            Margin="0,4,0,0"
                            MarkdownChanged="Editor_MarkdownChanged"
                            LinkInvoked="Editor_LinkInvoked" />
        </Grid>

        <Grid
            x:Name="ListPanel"
            Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                HorizontalAlignment="Center"
                Margin="0,0,0,16">
                <Button
                    Style="{StaticResource AccentButtonStyle}"
                    Click="New_Click"
                    Padding="20,10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="16" />
                        <TextBlock Text="New note" FontSize="14" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <ToggleButton
                    x:Name="SortToggle"
                    Click="SortToggle_Click"
                    Padding="12,10"
                    IsChecked="False"
                    ToolTipService.ToolTip="Toggle sort between updated and created date"
                    AutomationProperties.Name="Sort notes by created date">
                    <FontIcon Glyph="&#xE787;" FontSize="16" />
                </ToggleButton>
            </StackPanel>

            <TextBlock
                Grid.Row="1"
                Text="No notes yet. Select New note to create one."
                Margin="0,24,0,12"
                HorizontalAlignment="Center"
                Opacity="0.65"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

            <ListView
                Grid.Row="2"
                x:Name="NoteList"
                ItemsSource="{x:Bind ViewModel.Notes}"
                ItemContainerStyle="{StaticResource NoteCardItemStyle}"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemClick="NoteList_ItemClick"
                Padding="2"
                DoubleTapped="NoteList_DoubleTapped">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="{Binding DisplayTitle}"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding UpdatedText}"
                                    FontSize="11"
                                    Opacity="0.55"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0" />
                            </Grid>
                            <TextBlock
                                Text="{Binding Preview}"
                                FontSize="12"
                                MaxLines="2"
                                TextWrapping="WrapWholeWords"
                                TextTrimming="CharacterEllipsis"
                                Opacity="0.65" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
