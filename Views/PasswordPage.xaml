<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Evania.Views.PasswordPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Evania.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="PasswordPage_Loaded"
    Unloaded="PasswordPage_Unloaded">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="AllowFocusOnInteraction" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="24,20" />
            <Setter Property="Margin" Value="0,0,0,24" />
        </Style>

        <Style x:Key="RowDivider" TargetType="Line">
            <Setter Property="X1" Value="0" />
            <Setter Property="X2" Value="1" />
            <Setter Property="Y1" Value="0" />
            <Setter Property="Y2" Value="0" />
            <Setter Property="Stroke" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Margin" Value="-24,18,-24,18" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,12" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>

        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="SettingSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
        </Style>

        <!-- Card-style list item, the house style shared with the notes list: the default item
             template paints a flat bar, so the whole chrome is replaced with a rounded card. -->
        <Style x:Key="PasswordCardItemStyle" TargetType="ListViewItem">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="CardBorder.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="CardBorder.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="CardBorder.BorderBrush" Value="{ThemeResource AccentControlElevationBorderBrush}" />
                                            <Setter Target="CardBorder.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border
                                x:Name="CardBorder"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Padding="14,12" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- Parent Grid rows: 0 = InfoBar alerts (auto), 1 = content area. -->
    <ScrollViewer Padding="40,20,40,48" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                <InfoBar
                Severity="Error"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Closed="ErrorBar_Closed" />
                <InfoBar
                Severity="Success"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Closed="StatusBar_Closed" />
                <!-- Without a database master password these rows sit in the file in plain text; the page
                 says so until the user dismisses it or turns encryption on from Settings. -->
                <InfoBar
                Severity="Warning"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.ShowUnencryptedWarning, Mode=OneWay}"
                Title="Passwords are not encrypted"
                Message="Database encryption is off, so anyone with access to this PC can read them. Turn it on in Settings to protect the database with a master password."
                Closed="UnencryptedBar_Closed">
                    <InfoBar.ActionButton>
                        <Button Content="Open Settings" Click="OpenSettings_Click" Margin="0,0,8,8" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>

            <!-- List -->
            <Grid x:Name="ListPanel" Grid.Row="1" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel
                Grid.Row="0"
                Orientation="Horizontal"
                Spacing="8"
                HorizontalAlignment="Center"
                Margin="0,12,0,16">
                    <Button
                    Style="{StaticResource AccentButtonStyle}"
                    Click="New_Click"
                    Padding="20,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="16" />
                            <TextBlock Text="New password" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button
                    Style="{StaticResource ToolbarButtonStyle}"
                    Click="Import_Click"
                    ToolTipService.ToolTip="Import a Chrome, Edge, or Firefox password CSV">
                        <FontIcon Glyph="&#xE896;" FontSize="16" />
                    </Button>
                    <Button
                    Style="{StaticResource ToolbarButtonStyle}"
                    Click="Export_Click"
                    ToolTipService.ToolTip="Export all passwords as a CSV other managers can import">
                        <FontIcon Glyph="&#xE898;" FontSize="16" />
                    </Button>
                    <Button
                    Style="{StaticResource ToolbarButtonStyle}"
                    Click="Generator_Click"
                    ToolTipService.ToolTip="Generate a strong password">
                        <FontIcon Glyph="&#xE8B1;" FontSize="16" />
                    </Button>
                </StackPanel>

                <TextBlock
                Grid.Row="1"
                Text="No passwords yet. Select New password, or import your browser's CSV."
                Margin="0,24,0,12"
                HorizontalAlignment="Center"
                Opacity="0.65"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <ListView
                Grid.Row="2"
                x:Name="EntryList"
                ItemsSource="{x:Bind ViewModel.Entries}"
                ItemContainerStyle="{StaticResource PasswordCardItemStyle}"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemClick="EntryList_ItemClick"
                Padding="2">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                Glyph="&#xE72E;"
                                FontSize="16"
                                Opacity="0.6"
                                VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock
                                    Text="{Binding DisplaySite}"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                    Text="{Binding Username}"
                                    FontSize="12"
                                    Opacity="0.65"
                                    TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasTotp, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock
                                    Text="{Binding TotpCode}"
                                    FontFamily="Cascadia Mono,Consolas"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"
                                    MinWidth="70"
                                    TextAlignment="Right" />
                                    <ProgressBar
                                    Width="40"
                                    Height="4"
                                    Maximum="1"
                                    Value="{Binding TotpProgress}"
                                    VerticalAlignment="Center" />
                                    <Button
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Tag="{Binding}"
                                    Click="CopyTotp_Click"
                                    ToolTipService.ToolTip="Copy authenticator code">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                    </Button>
                                </StackPanel>
                                <StackPanel
                                Grid.Column="3"
                                Orientation="Horizontal"
                                Spacing="2"
                                VerticalAlignment="Center">
                                    <Button
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Tag="{Binding}"
                                    Click="CopyUsername_Click"
                                    ToolTipService.ToolTip="Copy username">
                                        <FontIcon Glyph="&#xE77B;" FontSize="13" />
                                    </Button>
                                    <Button
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Tag="{Binding}"
                                    Click="CopyPassword_Click"
                                    ToolTipService.ToolTip="Copy password">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Editor: unchanged column, capped at 880 and left-aligned -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="880" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
            x:Name="EditorPanel"
            Visibility="Collapsed">

                    <!-- Header / Actions toolbar -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,24">
                        <Button
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="Back_Click"
                        ToolTipService.ToolTip="Back to passwords"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">
                            <FontIcon Glyph="&#xE72B;" FontSize="16" />
                        </Button>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                            Text="PASSWORD ENTRY"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Opacity="0.6" />
                            <TextBox
                            PlaceholderText="App or site name"
                            Text="{Binding EditSite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="22"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Background="Transparent"
                            Padding="0">
                                <TextBox.Resources>
                                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                </TextBox.Resources>
                            </TextBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Visibility="{x:Bind ViewModel.IsSaving, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ProgressRing Width="16" Height="16" IsActive="True" />
                                <TextBlock Text="Saving" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                            </StackPanel>

                            <Button
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="Save_Click"
                            ToolTipService.ToolTip="Save">
                                <FontIcon Glyph="&#xE8FB;" FontSize="16" />
                            </Button>
                            <Button
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="Delete_Click"
                            ToolTipService.ToolTip="Delete password">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Credentials Section -->
                    <TextBlock Text="Credentials" Style="{StaticResource SectionHeader}" />

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="0">

                            <!-- Username row -->
                            <StackPanel>
                                <TextBlock Text="Username or Email" Style="{StaticResource SettingTitle}" />
                                <TextBlock Text="The account identifier used to sign in." Style="{StaticResource SettingSubtitle}" />
                                <TextBox
                                PlaceholderText="e.g. user@example.com"
                                Text="{Binding EditUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Height="36"
                                VerticalContentAlignment="Center"
                                Margin="0,12,0,0" />
                            </StackPanel>

                            <Line Style="{StaticResource RowDivider}" />

                            <!-- Password row -->
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Password or Secret Key" Style="{StaticResource SettingTitle}" />
                                        <TextBlock
                                        Text="Passwords, private keys, or recovery code blocks."
                                        Style="{StaticResource SettingSubtitle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Click="EditorCopyPassword_Click"
                                        ToolTipService.ToolTip="Copy password">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                        </Button>
                                        <Button
                                        x:Name="TogglePasswordButton"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Click="TogglePassword_Click"
                                        ToolTipService.ToolTip="Show password">
                                            <FontIcon x:Name="TogglePasswordIcon" Glyph="&#xE7B3;" FontSize="14" />
                                        </Button>
                                        <Button
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Click="EditorGenerate_Click"
                                        ToolTipService.ToolTip="Generate password">
                                            <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <TextBox
                                    x:Name="PasswordInput"
                                    PlaceholderText="Password, private key, or recovery codes"
                                    Text="{Binding EditPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    MinHeight="84"
                                    FontFamily="Cascadia Mono,Consolas"
                                    FontSize="13"
                                    Visibility="Collapsed" />
                                    <!-- Read-only stand-in that hides the value with bullets while the
                                         real input stays masked: a PasswordBox cannot be multi-line. -->
                                    <TextBox
                                    x:Name="PasswordInputMasked"
                                    IsReadOnly="True"
                                    IsTabStop="False"
                                    TextWrapping="Wrap"
                                    MinHeight="84"
                                    FontFamily="Cascadia Mono,Consolas"
                                    FontSize="13" />
                                </Grid>

                                <TextBlock
                                Text="Multi-line on purpose — long keys and recovery code blocks paste as-is."
                                FontSize="11"
                                Opacity="0.5"
                                Margin="0,6,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Two-Factor Authentication Section -->
                    <TextBlock Text="Two-Factor Authentication" Style="{StaticResource SectionHeader}" />

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="0">
                            <StackPanel>
                                <TextBlock Text="Authenticator Secret (TOTP)" Style="{StaticResource SettingTitle}" />
                                <TextBlock
                                Text="Base32 secret key, or an otpauth:// link. Generates standard 30-second one-time codes."
                                Style="{StaticResource SettingSubtitle}" />

                                <Grid Margin="0,12,0,0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <PasswordBox
                                    PlaceholderText="Base32 secret or otpauth:// uri"
                                    Password="{Binding EditTotpSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PasswordRevealMode="Peek"
                                    FontFamily="Cascadia Mono,Consolas"
                                    FontSize="13"
                                    Height="36"
                                    VerticalContentAlignment="Center" />
                                    <Button
                                    Grid.Column="1"
                                    Style="{StaticResource ActionButton}"
                                    Click="ScanTotpQr_Click"
                                    ToolTipService.ToolTip="Scan authenticator QR code with webcam">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE721;" FontSize="14" />
                                            <TextBlock Text="Scan QR" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Live code display -->
                                <Grid
                                Margin="0,14,0,0"
                                ColumnDefinitions="Auto,Auto,*"
                                ColumnSpacing="12"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.HasEditTotpCode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock
                                    Text="{x:Bind ViewModel.EditTotpCode, Mode=OneWay}"
                                    FontFamily="Cascadia Mono,Consolas"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                                    <ProgressBar
                                    Grid.Column="1"
                                    Width="56"
                                    Height="4"
                                    Maximum="1"
                                    Value="{x:Bind ViewModel.EditTotpProgress, Mode=OneWay}"
                                    VerticalAlignment="Center" />
                                    <Button
                                    Grid.Column="2"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="EditorCopyTotp_Click"
                                    ToolTipService.ToolTip="Copy code"
                                    VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                    </Button>
                                </Grid>

                                <TextBlock
                                Text="Codes refresh every 30 seconds, like a phone authenticator app."
                                FontSize="11"
                                Opacity="0.5"
                                Margin="0,6,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>