<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Evania.Views.SettingsPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Evania.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Evania.Converters"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:SettingsPageViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="SettingsPage_Loaded"
    Unloaded="SettingsPage_Unloaded">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!-- Card containers with comfortable internal padding -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="24,20" />
            <Setter Property="Margin" Value="0,0,0,24" />
        </Style>

        <!-- Individual setting rows -->
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Padding" Value="0,4,0,18" />
        </Style>

        <!-- Divider lines that span the full card width -->
        <Style x:Key="RowDivider" TargetType="Line">
            <Setter Property="X1" Value="0" />
            <Setter Property="X2" Value="1" />
            <Setter Property="Y1" Value="0" />
            <Setter Property="Y2" Value="0" />
            <Setter Property="Stroke" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Margin" Value="-24,0,-24,0" />
        </Style>

        <!-- Section headers with breathing room -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,12" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>

        <!-- Setting titles -->
        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <!-- Subtitles that fill the available width -->
        <Style x:Key="SettingSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- Action buttons -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="40,20,40,48" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel MaxWidth="880" HorizontalAlignment="Left">

            <!-- Error notification bar -->
            <InfoBar
                Severity="Warning"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                IsClosable="True"
                Closed="ErrorBar_Closed"
                Margin="0,0,0,24" />

            <!-- ==================== Database ==================== -->

            <TextBlock x:Name="DatabaseHeader" Text="Database" Style="{StaticResource SectionHeader}" />

            <Border Style="{StaticResource SectionCard}">
                <StackPanel Spacing="14">

                    <!-- Path row - takes full card width -->
                    <StackPanel>
                        <TextBlock x:Name="PathTitle" Text="Path" Style="{StaticResource SettingTitle}" />
                        <TextBlock
                            x:Name="PathSubtitle"
                            Text="Full path and file name of the LiteDB database."
                            Style="{StaticResource SettingSubtitle}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,12,0,0">
                            <TextBox
                                x:Name="PathBox"
                                Text="{x:Bind ViewModel.CandidatePath, Mode=TwoWay}"
                                FontFamily="Consolas"
                                Height="36"
                                VerticalContentAlignment="Center"
                                ToolTipService.ToolTip="The database file" />
                            <Button
                                Grid.Column="1"
                                Content="Browse…"
                                Style="{StaticResource ActionButton}"
                                Click="Browse_Click" />
                        </Grid>

                        <!-- Live state of the file at that path -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                            <FontIcon Glyph="&#xE8F2;" FontSize="13" Opacity="0.55" VerticalAlignment="Center" />
                            <TextBlock
                                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                FontSize="12"
                                Opacity="0.7"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <Line Style="{StaticResource RowDivider}" />

                    <!-- Password row -->
                    <StackPanel>
                        <TextBlock x:Name="PasswordTitle" Text="Password" Style="{StaticResource SettingTitle}" />
                        <TextBlock
                            x:Name="PasswordSubtitle"
                            Text="Encrypts the database. Leave empty for no encryption."
                            Style="{StaticResource SettingSubtitle}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,12,0,0">
                            <PasswordBox
                                x:Name="PasswordBox"
                                Height="36"
                                PasswordRevealMode="Peek"
                                PasswordChanged="PasswordBox_PasswordChanged" />
                            <Button
                                Grid.Column="1"
                                Content="Apply"
                                Style="{StaticResource AccentButtonStyle}"
                                MinWidth="100"
                                Height="32"
                                IsEnabled="{x:Bind ViewModel.NeedsApply, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ApplyDatabaseCommand}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                            <FontIcon Glyph="&#xE7BA;" FontSize="13" Opacity="0.55" VerticalAlignment="Top" Margin="0,1,0,0" />
                            <TextBlock
                                Text="Applying a changed password rebuilds the database - the current file is deleted and an empty one is protected by the new password."
                                FontSize="12"
                                Opacity="0.55"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==================== General ==================== -->

            <TextBlock x:Name="GeneralHeader" Text="General" Style="{StaticResource SectionHeader}" />

            <Border Style="{StaticResource SectionCard}">
                <StackPanel Spacing="0">

                    <Grid Style="{StaticResource SettingRow}" ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="StartWithWindowsTitle" Text="Start with Windows" Style="{StaticResource SettingTitle}" />
                            <TextBlock
                                x:Name="StartWithWindowsSubtitle"
                                Text="Launch Evania when you sign in. Windows lists it under Task Manager - Startup apps, where it can also be turned off."
                                Style="{StaticResource SettingSubtitle}" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="StartWithWindowsToggle"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            MinWidth="0"
                            IsOn="{x:Bind ViewModel.Settings.StartWithWindows, Mode=OneWay}"
                            OnContent=""
                            OffContent=""
                            Toggled="StartWithWindows_Toggled" />
                    </Grid>

                    <Line Style="{StaticResource RowDivider}" />

                    <Grid Style="{StaticResource SettingRow}" ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="CloseToTrayTitle" Text="Close to system tray" Style="{StaticResource SettingTitle}" />
                            <TextBlock
                                x:Name="CloseToTraySubtitle"
                                Text="The close button hides Evania instead of ending it, leaving its icon in the tray: double-click to come back, or use Exit Evania in its menu to really quit."
                                Style="{StaticResource SettingSubtitle}" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="CloseToTrayToggle"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            MinWidth="0"
                            IsOn="{x:Bind ViewModel.Settings.CloseToTray, Mode=OneWay}"
                            OnContent=""
                            OffContent=""
                            Toggled="CloseToTray_Toggled" />
                    </Grid>

                    <!-- Info note shown when both toggles are on -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="-4,8,0,0"
                        Visibility="{x:Bind ViewModel.StartsHiddenInTray, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE946;" FontSize="14" Opacity="0.5" VerticalAlignment="Top" Margin="0,1,0,0" />
                        <TextBlock
                            Text="With both on, Evania starts at sign-in already in the tray - no window appears until you open it."
                            FontSize="12"
                            Opacity="0.6"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==================== Screenshot ==================== -->

            <TextBlock x:Name="ScreenshotHeader" Text="Screenshot" Style="{StaticResource SectionHeader}" />

            <Border Style="{StaticResource SectionCard}">
                <StackPanel Spacing="0">

                    <Grid Style="{StaticResource SettingRow}" ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ShortcutTitle" Text="Shortcut" Style="{StaticResource SettingTitle}" />
                            <TextBlock
                                x:Name="ShortcutSubtitle"
                                Text="Takes a screenshot from anywhere in Windows. Whichever key is picked belongs to Evania while it runs."
                                Style="{StaticResource SettingSubtitle}" />
                        </StackPanel>
                        <ComboBox
                            x:Name="ShortcutCombo"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            MinWidth="200"
                            Height="36"
                            ItemsSource="{x:Bind ViewModel.HotkeyOptions}"
                            DisplayMemberPath="Display"
                            SelectionChanged="Shortcut_SelectionChanged" />
                    </Grid>

                    <Line Style="{StaticResource RowDivider}" />

                    <Grid Style="{StaticResource SettingRow}" ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="AutoSaveTitle" Text="Auto-save" Style="{StaticResource SettingTitle}" />
                            <TextBlock
                                x:Name="AutoSaveSubtitle"
                                Text="{x:Bind ViewModel.AutoSaveSubtitle, Mode=OneWay}"
                                Style="{StaticResource SettingSubtitle}" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="AutoSaveToggle"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            MinWidth="0"
                            IsOn="{x:Bind ViewModel.Settings.AutoSaveScreenshot, Mode=OneWay}"
                            OnContent=""
                            OffContent=""
                            Toggled="AutoSave_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== Chat ==================== -->

            <TextBlock x:Name="ChatHeader" Text="Chat" Style="{StaticResource SectionHeader}" />

            <Border Style="{StaticResource SectionCard}">
                <StackPanel Spacing="0">

                    <Grid Style="{StaticResource SettingRow}" ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ProviderTitle" Text="Provider" Style="{StaticResource SettingTitle}" />
                            <TextBlock
                                x:Name="ProviderSubtitle"
                                Text="Which AI chat service the Chat page opens. Your sign-in is kept for every provider, so switching back later finds you still logged in."
                                Style="{StaticResource SettingSubtitle}" />
                        </StackPanel>
                        <ComboBox
                            x:Name="ChatProviderCombo"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            MinWidth="200"
                            Height="36"
                            ItemsSource="{x:Bind ViewModel.ChatProviderOptions}"
                            DisplayMemberPath="Display"
                            SelectionChanged="ChatProvider_SelectionChanged" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
