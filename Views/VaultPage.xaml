<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Evania.Views.VaultPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Evania.Converters"
    xmlns:models="using:Evania.Models"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="VaultPage_Loaded"
    Unloaded="VaultPage_Unloaded">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <!-- Groups are swapped in by the view model whenever the list reloads; the ListView reads
             this source's View, set once in the constructor. -->
        <CollectionViewSource x:Name="GroupedEntriesSource" IsSourceGrouped="True" />

        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="AllowFocusOnInteraction" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="24,20" />
            <Setter Property="Margin" Value="0,0,0,24" />
        </Style>

        <Style x:Key="RowDivider" TargetType="Line">
            <Setter Property="X1" Value="0" />
            <Setter Property="X2" Value="1" />
            <Setter Property="Y1" Value="0" />
            <Setter Property="Y2" Value="0" />
            <Setter Property="Stroke" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Margin" Value="-24,18,-24,18" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,12" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>

        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="SettingSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
        </Style>

        <!-- Card-style list item, the house style shared with the notes list: the default item
             template paints a flat bar, so the whole chrome is replaced with a rounded card. -->
        <Style x:Key="VaultCardItemStyle" TargetType="ListViewItem">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="CardBorder.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="CardBorder.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="CardBorder.BorderBrush" Value="{ThemeResource AccentControlElevationBorderBrush}" />
                                            <Setter Target="CardBorder.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border
                                x:Name="CardBorder"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Padding="14,12" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- Parent Grid: Row 0 = InfoBar alerts (always visible), Row 1 = list/editor content. -->
    <ScrollViewer Padding="40,20,40,48" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                <InfoBar
                Severity="Error"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Closed="ErrorBar_Closed" />
                <InfoBar
                Severity="Success"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Closed="StatusBar_Closed" />
                <!-- Without a database master password these rows sit in the file in plain text; the page
                 says so until the user dismisses it or turns encryption on from Settings. -->
                <InfoBar
                Severity="Warning"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.ShowUnencryptedWarning, Mode=OneWay}"
                Title="Vault entries are not encrypted"
                Message="Database encryption is off, so anyone with access to this PC can read your vault. Turn it on in Settings to protect the database with a master password."
                Closed="UnencryptedBar_Closed">
                    <InfoBar.ActionButton>
                        <Button Content="Open Settings" Click="OpenSettings_Click" Margin="0,0,8,8" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>

            <!-- List -->
            <Grid x:Name="ListPanel" Grid.Row="1" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,12,0,16" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button
                        Style="{StaticResource AccentButtonStyle}"
                        Click="New_Click"
                        Padding="20,10"
                        Height="40">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="16" />
                                <TextBlock Text="New account" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button
                        Click="Import_Click"
                        Padding="12,10"
                        Height="40"
                        ToolTipService.ToolTip="Import accounts from a Chrome, Edge, or Firefox password CSV">
                            <FontIcon Glyph="&#xE896;" FontSize="16" />
                        </Button>
                        <Button
                        Click="Export_Click"
                        Padding="12,10"
                        Height="40"
                        ToolTipService.ToolTip="Export the vault as a CSV other managers can import">
                            <FontIcon Glyph="&#xE898;" FontSize="16" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <TextBlock
                Grid.Row="1"
                Text="No accounts yet. Select New account to create one."
                Margin="0,24,0,12"
                HorizontalAlignment="Center"
                Opacity="0.65"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <ListView
                Grid.Row="2"
                x:Name="EntryList"
                ItemContainerStyle="{StaticResource VaultCardItemStyle}"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemClick="EntryList_ItemClick"
                Padding="2">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="models:VaultSiteGroup">
                                    <Grid ColumnSpacing="10" Margin="2,14,2,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                        Width="34"
                                        Height="34"
                                        CornerRadius="8"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                            <TextBlock
                                            Text="{x:Bind Initial}"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock
                                            Text="{x:Bind DisplayName}"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind AccountCountText}" FontSize="11" Opacity="0.6" />
                                        </StackPanel>
                                        <Button
                                        Grid.Column="2"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Tag="{Binding}"
                                        Click="AddToSite_Click"
                                        ToolTipService.ToolTip="Add another account for this site"
                                        VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:VaultListItem">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                Glyph="&#xE192;"
                                FontSize="16"
                                Opacity="0.55"
                                VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock
                                    Text="{x:Bind DisplayName}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                    Text="{x:Bind SecondaryText}"
                                    FontSize="11"
                                    Opacity="0.6"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{x:Bind HasSecondaryText, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                                <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center">
                                    <Border
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="5,1"
                                    Visibility="{x:Bind HasTotp, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="OTP" FontSize="10" Opacity="0.75" />
                                    </Border>
                                    <Border
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="5,1"
                                    Visibility="{x:Bind HasSecret, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Secret" FontSize="10" Opacity="0.75" />
                                    </Border>
                                    <Border
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="5,1"
                                    Visibility="{x:Bind HasNote, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Note" FontSize="10" Opacity="0.75" />
                                    </Border>
                                </StackPanel>
                                <StackPanel
                                Grid.Column="3"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind HasTotp, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock
                                    Text="{Binding TotpCode, Mode=OneWay}"
                                    FontFamily="Cascadia Mono,Consolas"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"
                                    MinWidth="70"
                                    TextAlignment="Right" />
                                    <ProgressBar
                                    Width="40"
                                    Height="4"
                                    Maximum="1"
                                    Value="{Binding TotpProgress, Mode=OneWay}"
                                    VerticalAlignment="Center" />
                                    <Button
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Tag="{Binding}"
                                    Click="CopyTotp_Click"
                                    ToolTipService.ToolTip="Copy authenticator code">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                    </Button>
                                </StackPanel>
                                <StackPanel
                                Grid.Column="4"
                                Orientation="Horizontal"
                                Spacing="2"
                                VerticalAlignment="Center">
                                    <Button
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Tag="{Binding}"
                                    Click="CopyUsername_Click"
                                    ToolTipService.ToolTip="Copy username">
                                        <FontIcon Glyph="&#xE77B;" FontSize="13" />
                                    </Button>
                                    <Button
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Tag="{Binding}"
                                    Click="CopyPassword_Click"
                                    ToolTipService.ToolTip="Copy password">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Editor: column capped at 880 and left-aligned -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="880" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
            x:Name="EditorPanel"
            Visibility="Collapsed"
            Margin="0,16,0,0">

                    <!-- Header / Actions toolbar -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
                        <Button
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="Back_Click"
                        ToolTipService.ToolTip="Back to the vault"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">
                            <FontIcon Glyph="&#xE72B;" FontSize="16" />
                        </Button>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                            Text="VAULT ENTRY"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Opacity="0.6" />
                            <TextBox
                            PlaceholderText="Site or app name"
                            Text="{Binding EditSite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="22"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Background="Transparent"
                            Padding="0">
                                <TextBox.Resources>
                                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                </TextBox.Resources>
                            </TextBox>
                            <TextBlock
                            Text="{x:Bind ViewModel.EditTimestampsText, Mode=OneWay}"
                            FontSize="11"
                            Opacity="0.55"
                            Visibility="{x:Bind ViewModel.IsExistingEntry, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Visibility="{x:Bind ViewModel.IsSaving, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ProgressRing Width="16" Height="16" IsActive="True" />
                                <TextBlock Text="Saving" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                            </StackPanel>

                            <Button
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="Delete_Click"
                            ToolTipService.ToolTip="Delete account"
                            Visibility="{x:Bind ViewModel.IsExistingEntry, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                            <Button
                            Style="{StaticResource AccentButtonStyle}"
                            Click="Save_Click"
                            MinWidth="86"
                            ToolTipService.ToolTip="Save account">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8FB;" FontSize="14" />
                                    <TextBlock Text="Save" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Account Section -->
                    <TextBlock Text="Account" Style="{StaticResource SectionHeader}" />

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="0">

                            <!-- Username row -->
                            <StackPanel>
                                <TextBlock Text="Username" Style="{StaticResource SettingTitle}" />
                                <TextBlock Text="The name you sign in with." Style="{StaticResource SettingSubtitle}" />
                                <TextBox
                                PlaceholderText="e.g. ada"
                                Text="{Binding EditUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Height="36"
                                VerticalContentAlignment="Center"
                                Margin="0,12,0,0" />
                            </StackPanel>

                            <Line Style="{StaticResource RowDivider}" />

                            <!-- Email row -->
                            <StackPanel>
                                <TextBlock Text="Email" Style="{StaticResource SettingTitle}" />
                                <TextBlock Text="The email address for this account, when it differs from the username." Style="{StaticResource SettingSubtitle}" />
                                <TextBox
                                PlaceholderText="e.g. ada@example.com"
                                Text="{Binding EditEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Height="36"
                                VerticalContentAlignment="Center"
                                Margin="0,12,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Password Section -->
                    <TextBlock Text="Password" Style="{StaticResource SectionHeader}" />

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="0">

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Password" Style="{StaticResource SettingTitle}" />
                                    <TextBlock
                                    Text="Passwords, private keys, or recovery code blocks."
                                    Style="{StaticResource SettingSubtitle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="EditorCopyPassword_Click"
                                    ToolTipService.ToolTip="Copy password">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                    </Button>
                                    <Button
                                    x:Name="TogglePasswordButton"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="TogglePassword_Click"
                                    ToolTipService.ToolTip="Show password">
                                        <FontIcon x:Name="TogglePasswordIcon" Glyph="&#xE7B3;" FontSize="14" />
                                    </Button>
                                    <Button
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="EditorGenerate_Click"
                                    ToolTipService.ToolTip="Generate password">
                                        <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <TextBox
                                x:Name="PasswordInput"
                                PlaceholderText="Password, private key, or recovery codes"
                                Text="{Binding EditPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MinHeight="84"
                                FontFamily="Cascadia Mono,Consolas"
                                FontSize="13"
                                Visibility="Collapsed" />
                                <!-- Read-only stand-in that hides the value with bullets while the
                                     real input stays masked: a PasswordBox cannot be multi-line. -->
                                <TextBox
                                x:Name="PasswordInputMasked"
                                IsReadOnly="True"
                                IsTabStop="False"
                                TextWrapping="Wrap"
                                MinHeight="84"
                                FontFamily="Cascadia Mono,Consolas"
                                FontSize="13" />
                            </Grid>

                            <!-- Strength meter -->
                            <StackPanel
                            Margin="0,10,0,0"
                            Spacing="6"
                            Visibility="{x:Bind ViewModel.HasEditPassword, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ProgressBar Maximum="1" Value="{x:Bind ViewModel.EditPasswordStrength, Mode=OneWay}" Height="4" />
                                <TextBlock Text="{x:Bind ViewModel.EditPasswordStrengthText, Mode=OneWay}" FontSize="11" Opacity="0.6" />
                            </StackPanel>

                            <TextBlock
                            Text="Multi-line on purpose — long keys and recovery code blocks paste as-is."
                            FontSize="11"
                            Opacity="0.5"
                            Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- OTP (Two-Factor) Section -->
                    <TextBlock Text="OTP (Two-Factor)" Style="{StaticResource SectionHeader}" />

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="0">
                            <StackPanel>
                                <TextBlock Text="OTP Secret" Style="{StaticResource SettingTitle}" />
                                <TextBlock
                                Text="Base32 secret key, or an otpauth:// link. Generates standard 30-second one-time codes."
                                Style="{StaticResource SettingSubtitle}" />

                                <Grid Margin="0,12,0,0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <PasswordBox
                                    PlaceholderText="Base32 secret or otpauth:// uri"
                                    Password="{Binding EditTotpSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PasswordRevealMode="Peek"
                                    FontFamily="Cascadia Mono,Consolas"
                                    FontSize="13"
                                    Height="36"
                                    VerticalContentAlignment="Center" />
                                    <Button
                                    Grid.Column="1"
                                    Style="{StaticResource ActionButton}"
                                    Click="ScanTotpQr_Click"
                                    ToolTipService.ToolTip="Scan authenticator QR code with webcam">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE721;" FontSize="14" />
                                            <TextBlock Text="Scan QR" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Live code display -->
                                <Grid
                                Margin="0,14,0,0"
                                ColumnDefinitions="Auto,Auto,*"
                                ColumnSpacing="12"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.HasEditTotpCode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock
                                    Text="{x:Bind ViewModel.EditTotpCode, Mode=OneWay}"
                                    FontFamily="Cascadia Mono,Consolas"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                                    <ProgressBar
                                    Grid.Column="1"
                                    Width="56"
                                    Height="4"
                                    Maximum="1"
                                    Value="{x:Bind ViewModel.EditTotpProgress, Mode=OneWay}"
                                    VerticalAlignment="Center" />
                                    <Button
                                    Grid.Column="2"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="EditorCopyTotp_Click"
                                    ToolTipService.ToolTip="Copy code"
                                    VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                    </Button>
                                </Grid>

                                <TextBlock
                                Text="Codes refresh every 30 seconds, like a phone authenticator app."
                                FontSize="11"
                                Opacity="0.5"
                                Margin="0,6,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Secret Section -->
                    <TextBlock Text="Secret" Style="{StaticResource SectionHeader}" />

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="0">
                            <TextBlock Text="Secret" Style="{StaticResource SettingTitle}" />
                            <TextBlock
                            Text="Extra hidden field for API keys, recovery codes, or security answers."
                            Style="{StaticResource SettingSubtitle}" />

                            <Grid Margin="0,12,0,0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <PasswordBox
                                PlaceholderText="Hidden until you peek"
                                Password="{Binding EditSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PasswordRevealMode="Peek"
                                FontFamily="Cascadia Mono,Consolas"
                                FontSize="13"
                                Height="36"
                                VerticalContentAlignment="Center" />
                                <Button
                                Grid.Column="1"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Click="EditorCopySecret_Click"
                                ToolTipService.ToolTip="Copy secret"
                                VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Note Section -->
                    <TextBlock Text="Note" Style="{StaticResource SectionHeader}" />

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="0">
                            <TextBlock Text="Note" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Anything else worth remembering about this account." Style="{StaticResource SettingSubtitle}" />
                            <TextBox
                            PlaceholderText="Add a note"
                            Text="{Binding EditNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="96"
                            Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
