<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Evania.Windows.EditScreenshotWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Edit Screenshot">

    <Grid x:Name="RootGrid"
          Loaded="RootGrid_Loaded"
          PointerPressed="RootGrid_PointerPressed"
          PointerMoved="RootGrid_PointerMoved"
          PointerReleased="RootGrid_PointerReleased"
          DoubleTapped="RootGrid_DoubleTapped"
          KeyDown="RootGrid_KeyDown">
        <Image
            x:Name="ScreenshotImage"
            Stretch="UniformToFill"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

        <Canvas x:Name="TintCanvas" />

        <Canvas x:Name="DrawingCanvas" />

        <Border
            x:Name="ToolbarBorder"
            Background="#E8303030"
            CornerRadius="8"
            Padding="4,4"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,12,0,0"
            BorderBrush="#40FFFFFF"
            BorderThickness="1">

            <StackPanel x:Name="ToolbarPanel" Orientation="Horizontal" Spacing="2">
                <FontIcon
                    x:Name="GripIcon"
                    Glyph="&#xE76F;"
                    FontSize="14"
                    Margin="4,0,4,0"
                    VerticalAlignment="Center"
                    Foreground="#AAFFFFFF"
                    PointerPressed="GripIcon_PointerPressed" />

                <ToggleButton
                    x:Name="SelectToolButton"
                    ToolTipService.ToolTip="Select"
                    IsChecked="True"
                    Click="SelectToolButton_Click">
                    <FontIcon Glyph="&#xE924;" FontSize="16" />
                </ToggleButton>

                <ToggleButton
                    x:Name="DrawBoxToolButton"
                    ToolTipService.ToolTip="Draw Box"
                    Click="DrawBoxToolButton_Click">
                    <FontIcon Glyph="&#xE739;" FontSize="16" />
                </ToggleButton>

                <ToggleButton
                    x:Name="DrawArrowToolButton"
                    ToolTipService.ToolTip="Draw Arrow"
                    Click="DrawArrowToolButton_Click">
                    <FontIcon Glyph="&#xE741;" FontSize="16" />
                </ToggleButton>

                <ToggleButton
                    x:Name="DrawTextToolButton"
                    ToolTipService.ToolTip="Draw Text"
                    Click="DrawTextToolButton_Click">
                    <FontIcon Glyph="&#xF7B5;" FontSize="16" />
                </ToggleButton>

                <ToggleButton
                    x:Name="BlurToolButton"
                    ToolTipService.ToolTip="Blur"
                    Click="BlurToolButton_Click">
                    <FontIcon Glyph="&#xED61;" FontSize="16" />
                </ToggleButton>

                <Border
                    Width="1"
                    Background="#40FFFFFF"
                    Margin="4,4" />

                <Button
                    x:Name="CopyButton"
                    ToolTipService.ToolTip="Copy"
                    Click="CopyButton_Click">
                    <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                </Button>

                <Button
                    x:Name="CopyTextButton"
                    ToolTipService.ToolTip="Copy Text"
                    Click="CopyTextButton_Click">
                    <FontIcon Glyph="&#xE8AC;" FontSize="16" />
                </Button>

                <Button
                    x:Name="SaveButton"
                    ToolTipService.ToolTip="Save"
                    Click="SaveButton_Click">
                    <FontIcon Glyph="&#xE74E;" FontSize="16" />
                </Button>

                <Button
                    x:Name="CancelButton"
                    ToolTipService.ToolTip="Cancel"
                    Click="CancelButton_Click">
                    <FontIcon Glyph="&#xE711;" FontSize="16" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>