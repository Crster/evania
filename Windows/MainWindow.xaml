<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Evania.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Evania"
    xmlns:vm="using:Evania.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Evania">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            Grid.Row="0"
            Title="Evania"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/Evania.ico" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="TitleBarWebBackButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        Width="24"
                        Height="24"
                        MinWidth="24"
                        MinHeight="24"
                        Padding="0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        IsEnabled="False"
                        Click="TitleBarWebBackButton_Click">
                        <SymbolIcon Symbol="Back" />
                    </Button>
                    <AutoSuggestBox
                        x:Name="TitleBarSearchBox"
                        Width="360"
                        VerticalAlignment="Center"
                        PlaceholderText="Search notes"
                        QueryIcon="Find"
                        TextChanged="TitleBarSearchBox_TextChanged" />
                </StackPanel>
            </TitleBar.Content>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="False"
            MenuItemsSource="{x:Bind ViewModel.MenuItems}"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItemTemplate>
                <DataTemplate x:DataType="vm:NavigationItemViewModel">
                    <NavigationViewItem
                        Content="{x:Bind Content}"
                        Tag="{x:Bind Tag}"
                        Icon="{x:Bind Icon}" />
                </DataTemplate>
            </NavigationView.MenuItemTemplate>
            <ContentPresenter x:Name="NavigationPresenter" />
        </NavigationView>
    </Grid>
</Window>
