<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Evania.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Evania"
    xmlns:vm="using:Evania.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Evania">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="False"
            MenuItemsSource="{x:Bind ViewModel.MenuItems}"
            SelectedItem="{x:Bind ViewModel.SelectedMenuItem, Mode=TwoWay}"
            SelectionChanged="NavView_SelectionChanged">
            
            <NavigationView.MenuItemTemplate>
                <DataTemplate x:DataType="vm:NavigationItemViewModel">
                    <NavigationViewItem
                        Content="{x:Bind Content}"
                        Tag="{x:Bind Tag}"
                        IsSelected="{x:Bind IsSelected, Mode=TwoWay}">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="{x:Bind IconGlyph}" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </DataTemplate>
            </NavigationView.MenuItemTemplate>
            <Frame x:Name="NavigationPresenter" />
        </NavigationView>
    </Grid>
</Window>
